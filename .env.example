# متغيرات البيئة لمتجر روح الثوب للخياطة الفاخرة
# انسخ هذا الملف إلى .env واملأ القيم

# ===== طريقة الإرسال الموصى بها لـ Render =====
# Resend API (الأكثر ضماناً، يستخدم HTTPS مباشرة بدون حظر منافذ SMTP)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_SENDER_EMAIL=onboarding@resend.dev
SENDER_NAME=روح الثوب للخياطة الفاخرة

# ===== بديل: Brevo SMTP =====
# لو ما تبغا تستخدم Resend، استخدم Brevo
# BREVO_SMTP_USER=your_brevo_login
# BREVO_SMTP_KEY=your_brevo_smtp_key
# BREVO_SENDER_EMAIL=your-verified-email@domain.com

# ===== بديل: Gmail SMTP (محلياً فقط) =====
# EMAIL_USER=your_email@gmail.com
# EMAIL_PASS=your_app_password

# ===== إعدادات عامة =====
# إيميل الإدارة لاستقبال إشعارات الطلبات
ADMIN_EMAIL=shirtclothes5@gmail.com

# منفذ السيرفر (Render يضبطه تلقائياً)
PORT=3000
